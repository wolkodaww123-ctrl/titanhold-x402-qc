# Public receiving address for USDC (0x...). Required. Never put a private key here.
PAY_TO=0xYourReceivingAddress
# eip155:84532 = Base Sepolia (default, testnet). eip155:8453 = Base mainnet.
X402_NETWORK=eip155:84532
# Testnet default: https://x402.org/facilitator . Mainnet default: "cdp" (Coinbase CDP facilitator; needs
# CDP_API_KEY_ID / CDP_API_KEY_SECRET, Node >= 22, and `npm i @coinbase/cdp-sdk @x402/svm`). Or any facilitator URL.
#FACILITATOR_URL=https://x402.org/facilitator
# Optional Base Builder Code (register the app at dashboard.base.org -> Settings -> Builder Codes)
#BUILDER_CODE=
PORT=8091
HOST=127.0.0.1
PUBLIC_URL=https://your-public-host.example
OLLAMA_URL=http://127.0.0.1:11434
QG_MODEL=qwen2.5vl:7b
# QC_BACKEND=mock  # tests / payment-flow demos only: returns a fixed verdict, runs no model
